# 参考源码（只读对照，不入库）
vllm-src/

# 模型权重（仅顶层 /models，HF hub 结构；不影响 nano_vllm/models/）
/models/

# agent 工具目录
.codeartsdoer/
.arts/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 大文件与中间产物（golden 数据用脚本确定性再生成，只入库小快照）
*.npy
*.safetensors
*.bin
*.pt
*.pth
# bench 图：只入库 JSON 数据（脚本 + JSON 足以复现），位图不入
bench/results/*.png
# profiler 原始 trace（24MB/8MB 量级，可由脚本重新生成）
bench/results/*_trace.json

